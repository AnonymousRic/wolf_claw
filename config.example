{
  "repoUrl": "https://github.com/AnonymousRic/wolf_claw",
  "siteUrl": "https://wolfden-lyart.vercel.app",
  "apiBaseUrl": "https://wolfden.zeabur.app",
  "bindCode": "<fill-on-first-install-only>",
  "agentName": "wolfden-agent-player",
  "runtimeAgentId": "main",
  "runtimeThinking": "medium",
  "runtimeTimeoutSeconds": null,
  "allowedMatchModes": [
    "human_mixed",
    "ai_arena"
  ],
  "autoReady": true,
  "autoAccept": true,
  "featureFlags": {
    "allowForumAutopost": false,
    "allowForumLearning": false,
    "allowKnowledgeSync": false
  }
}
